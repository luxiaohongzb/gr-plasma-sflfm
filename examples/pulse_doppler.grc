options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: untitled
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Not titled yet
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: bandwidth
  id: variable
  parameters:
    comment: ''
    value: '30000000.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [344, 360.0]
    rotation: 0
    state: true
- name: end_freq
  id: variable
  parameters:
    comment: ''
    value: '3300000000.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [392, 56.0]
    rotation: 0
    state: true
- name: n_pulse_cpi
  id: variable
  parameters:
    comment: ''
    value: '128'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [288, 12.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '60000000.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 12]
    rotation: 0
    state: enabled
- name: start_freq
  id: variable
  parameters:
    comment: ''
    value: '3000000000.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [368, 168.0]
    rotation: 0
    state: enabled
- name: step
  id: variable
  parameters:
    comment: ''
    value: '30000000.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [256, 288.0]
    rotation: 0
    state: true
- name: plasma_cw_to_pulsed_0
  id: plasma_cw_to_pulsed
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    prf: 1e3
    prf_key: radar:prf
    samp_rate: samp_rate
    sample_rate_key: core:sample_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 296.0]
    rotation: 0
    state: enabled
- name: plasma_freq_step_controller_0
  id: plasma_freq_step_controller
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    cyclic: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    start_freq: start_freq
    step_freq: step
    stop_freq: end_freq
    tx_freq_key: core:tx_freq
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1096, 148.0]
    rotation: 0
    state: disabled
- name: plasma_ifft_range_profile_0
  id: plasma_ifft_range_profile
  parameters:
    affinity: ''
    alias: ''
    bandwidth: 30e6
    comment: ''
    depth: '100'
    dynamic_range: '60'
    freq_key: core:rx_freq
    gui_hint: ''
    n_fft_synthesis: '256'
    prf: 1e3
    pulse_width: 10e-6
    sample_rate: samp_rate
    sweep_start: start_freq
    sweep_step: step
    sweep_stop: end_freq
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1072, 400.0]
    rotation: 0
    state: enabled
- name: plasma_lfm_source_0
  id: plasma_lfm_source
  parameters:
    affinity: ''
    alias: ''
    bandwidth: bandwidth
    bandwidth_key: radar:bandwidth
    comment: ''
    duration_key: radar:duration
    label_key: core:label
    maxoutbuf: '0'
    minoutbuf: '0'
    prf: '0'
    prf_key: radar:prf
    pulse_width: 10e-6
    samp_rate: samp_rate
    sample_rate_key: core:sample_rate
    start_freq: -bandwidth/2
    start_freq_key: radar:start_freq
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [352, 284.0]
    rotation: 0
    state: true
- name: plasma_pulse_doppler_0
  id: plasma_pulse_doppler
  parameters:
    affinity: ''
    alias: ''
    backend: plasma.Device.CUDA
    comment: ''
    depth: '100'
    doppler_fft_size_key: doppler_fft_size
    maxoutbuf: '0'
    minoutbuf: '0'
    n_pulse_cpi: n_pulse_cpi
    nfft: n_pulse_cpi
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1432, 308.0]
    rotation: 0
    state: disabled
- name: plasma_pulse_to_cpi_0
  id: plasma_pulse_to_cpi
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    n_pulse_cpi: n_pulse_cpi
    n_pulse_cpi_key: radar:n_pulse_cpi
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1312, 88.0]
    rotation: 0
    state: disabled
- name: plasma_range_doppler_sink_0
  id: plasma_range_doppler_sink
  parameters:
    affinity: ''
    alias: ''
    center_freq: 2.4e9
    center_freq_key: core:tx_freq
    comment: ''
    depth: '10'
    detection_indices_key: detection_indices
    dynamic_range: '60'
    dynamic_range_key: dynamic_range
    gui_hint: ''
    n_matrix_col_key: n_matrix_col
    nrow: n_pulse_cpi
    prf_key: radar:prf
    pulsewidth_key: radar:duration
    samp_rate: samp_rate
    samp_rate_key: core:sample_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1696, 260.0]
    rotation: 0
    state: disabled
- name: plasma_sweep_collector_0
  id: plasma_sweep_collector
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    freq_key: core:rx_freq
    maxoutbuf: '0'
    minoutbuf: '0'
    output_dir: /home/mingliu/Documents/gr-plasma/tools/data/test5
    output_prefix: '"sweep"'
    save_cycles: '3'
    sweep_start: start_freq
    sweep_step: step
    sweep_stop: end_freq
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [752, 400.0]
    rotation: 0
    state: enabled
- name: plasma_usrp_radar_0
  id: plasma_usrp_radar
  parameters:
    affinity: ''
    alias: ''
    args: addr=192.168.40.2
    cal_file: ''
    comment: ''
    elevate_priority: 'True'
    hop_end_freq: end_freq
    hop_start_freq: start_freq
    hop_step: step
    lo_stabilize_time: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
    rx_freq: 2.4e9
    rx_freq_key: core:rx_freq
    rx_gain: '10'
    samp_rate: samp_rate
    sample_start_key: core:sample_start
    start_delay: '0.5'
    tx_freq: 2.4e9
    tx_freq_key: core:tx_freq
    tx_gain: '10'
    verbose: 'True'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [512, 308.0]
    rotation: 0
    state: enabled

connections:
- [plasma_cw_to_pulsed_0, out, plasma_usrp_radar_0, in]
- [plasma_lfm_source_0, out, plasma_cw_to_pulsed_0, in]
- [plasma_sweep_collector_0, out, plasma_ifft_range_profile_0, in]
- [plasma_usrp_radar_0, out, plasma_sweep_collector_0, in]

metadata:
  file_format: 1
